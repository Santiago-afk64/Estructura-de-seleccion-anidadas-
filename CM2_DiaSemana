Algoritmo DiaSemana()
  Definir dia Como Entero
  Definir nombre, tipo Como Caracter

  Escribir "Ingrese un número del 1 al 7"
  Leer dia

  Segun dia Hacer
    1:
      nombre <- "Lunes"
      tipo <- "Día de clases"
    2:
      nombre <- "Martes"
      tipo <- "Día de clases"
    3:
      nombre <- "Miércoles"
      tipo <- "Día de clases"
    4:
      nombre <- "Jueves"
      tipo <- "Día de clases"
    5:
      nombre <- "Viernes"
      tipo <- "Día de clases"
    6:
      nombre <- "Sábado"
      tipo <- "Fin de semana"
    7:
      nombre <- "Domingo"
      tipo <- "Fin de semana"
    De Otro Modo:
      nombre <- "Inválido"
      tipo <- "Número fuera de rango (1 a 7)"
  FinSegun

  Escribir "Día: ", nombre
  Escribir "Tipo: ", tipo
FinAlgoritmo
